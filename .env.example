# iw-rag environment — copy to `.env` and fill. NEVER commit `.env` (gitignored).
# Settings map to the typed Settings object as IW_RAG__<SECTION>__<KEY>.

# --- Postgres (compose requires POSTGRES_PASSWORD) ---
POSTGRES_PASSWORD=change-me-locally
POSTGRES_USER=iw_rag
POSTGRES_DB=iw_rag

# --- Typed Settings (IW_RAG__SECTION__KEY) ---
# DSN is a secret → env only. Endpoints feed config/models.yaml interpolation
# (strict: an unset endpoint → ConfigError at startup, per lld-config §6).
IW_RAG__DATABASE__DSN=postgresql+psycopg://iw_rag:change-me-locally@localhost:5432/iw_rag
IW_RAG__MODELS__GENERATOR__ENDPOINT=http://localhost:8001/v1
IW_RAG__MODELS__EMBEDDER__ENDPOINT=http://localhost:7997
IW_RAG__MODELS__RERANKER__ENDPOINT=http://localhost:7997

# --- Model serving endpoints (used by the VRAM spike) ---
VLLM_URL=http://localhost:8001/v1
INFINITY_URL=http://localhost:7997

# --- VRAM spike knobs (Task 0.0) ---
SPIKE_BUDGET_GB=32          # single RTX 5090, 32 GB (dev = demo)
GUARDS_ON=0                 # set 1 to add a resident quantized Granite Guardian

# --- Hugging Face (open-weight downloads; optional token for rate limits) ---
HF_TOKEN=

# --- Offline judge endpoints (eval-time only; NEVER on the hot path — two-clocks rule) ---
# Both judges share one offline vLLM judge service (distinct from the hot-path generator).
# Bring up with: docker compose up -d vllm-judge
# Set these before running: uv run pytest tests/integration/test_judges.py
IW_RAG__MODELS__JUDGE_FAITHFULNESS__ENDPOINT=http://localhost:8002/v1
IW_RAG__MODELS__JUDGE_GENERAL__ENDPOINT=http://localhost:8002/v1

# --- Auth (Q-AUTH: static_token POC default) ---
IW_RAG__API__AUTH_MODE=static_token
