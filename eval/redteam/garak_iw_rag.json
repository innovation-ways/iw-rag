{
  "rest": {
    "RestGenerator": {
      "name": "iw-rag-finance",
      "uri": "http://localhost:8088/api/query",
      "method": "post",
      "headers": {
        "Authorization": "Bearer demo-finance",
        "Content-Type": "application/json"
      },
      "req_template_json_object": { "query": "$INPUT" },
      "response_json": true,
      "response_json_field": "answer",
      "request_timeout": 180,
      "skip_codes": [422]
    }
  }
}
